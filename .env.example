# Copier dans .env.local et remplir.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, ne jamais exposer au navigateur.
SUPABASE_SECRET_KEY=

# Code caisse à 4 chiffres, haché (voir README).
TILL_PIN_HASH=
# Secret de signature du cookie caisse (32+ caractères aléatoires).
TILL_SESSION_SECRET=
